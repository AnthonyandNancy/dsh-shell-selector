# dsh-shell-selector bundle patch — applied after every bundle layer, before
# profile / home / --patch overlays.
#
# THE SHELL STACK IS DECIDED AT PROCESS STARTUP, NEVER AT RUNTIME. The `!!js`
# expressions below read the `shell-selector` profile patch row once — falling
# back to the retired `$DSH_HOME/settings.yaml` — while the loader activates
# these rows; nothing in this file runs after boot.
#
# The expressions are GENERATED from src/boot/expressions.ts by
# scripts/render-patch.mjs — do not edit them by hand. They are evaluated by
# the Loader with `new Function("ctx","expr","with(ctx){return eval(expr)}")`
# where only `process`/`Buffer`/`fetch`/`globalThis` are guaranteed.

# Mount the host plugin (settings, snapshot, per-agent Shell Tool adaptation,
# Settings endpoint). Without this row the bundle's patch lines would apply but
# the plugin itself would never load.
- insert:
    - id: shell-selector
      name: 'dsh-shell-selector'

# Executor rows (host plane): `ctx.shell` is provided by exactly one of them.
# mode=default keeps the shipped platform rule; the config can only change
# them for the next process.
- id: bash-sandbox
  disabled: !!js |
    {{BASH_SANDBOX_DISABLED_EXPR}}

- id: pwsh-sandbox
  disabled: !!js |
    {{PWSH_SANDBOX_DISABLED_EXPR}}
  config:
    pwshPath: !!js |
      {{PWSH_PATH_EXPR}}
